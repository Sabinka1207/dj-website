# ── Email ─────────────────────────────────────────────────────────────────────
# Resend API key (https://resend.com) — used to send booking enquiry emails
RESEND_API_KEY=re_your_api_key

# Email address that receives booking enquiries
CONTACT_EMAIL=your@email.com

# ── Telegram notifications ─────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token
# Chat ID to send messages to (your personal chat or a group)
TELEGRAM_CHAT_ID=your_chat_id
# Environment tag shown in error alerts — use "prod" for production, "stage" for staging
APP_ENV=prod

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────────
# Use the Session Mode pooler URL from Supabase → Connect → Session pooler
# This avoids IPv6-only direct connections that fail on Render's free tier
# Leave as H2 defaults for local dev (no DATABASE_URL needed locally)
DATABASE_URL=jdbc:postgresql://aws-1-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-password
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ── Admin panel ────────────────────────────────────────────────────────────────
# Password for the password-based admin login
ADMIN_PASSWORD=your-strong-password

# Google account allowed to log in via Google Sign-In
ADMIN_GOOGLE_EMAIL=your@gmail.com

# ── Frontend (build-time, prefix VITE_) ───────────────────────────────────────
# Google OAuth Client ID — from Google Cloud Console → APIs & Services → Credentials
# Add authorized origins: http://localhost:5173, https://dj-sabi.com (and staging URL)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Cloudinary (photo storage) ────────────────────────────────────────────────
# Get from cloudinary.com → Dashboard (free tier: 25 GB storage, 25 GB/month bandwidth)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Render / deployment ────────────────────────────────────────────────────────
# Vercel deployment URL — used for CORS allowlist on backend
VERCEL_URL=your-vercel-url.vercel.app
