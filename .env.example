# Mail (iCloud SMTP)
MAIL_USERNAME=your_apple_id@icloud.com
MAIL_PASSWORD=your_app_specific_password

# Where booking emails are sent
CONTACT_EMAIL=your_apple_id@icloud.com

# Telegram bot notification
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Vercel deployment URL (e.g. dj-sabi.vercel.app) — set in Railway env vars
VERCEL_URL=your_vercel_url
